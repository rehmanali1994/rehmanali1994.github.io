@article{Ali2022CurvilinearAngularSpectrumMethod,
  title={Angular spectrum method for curvilinear arrays: Theory and application to Fourier beamforming},
  author={Ali, Rehman and Dahl, Jeremy},
  journal={JASA Express Letters},
  volume={2},
  number={5},
  year={2022},
  doi={10.1121/10.0010536},
